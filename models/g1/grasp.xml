<mujoco model="g1_grasp">

    <compiler angle="radian"/>

    <include file="./scene_with_hands.xml"/>
    <option gravity="0 0 -9.81"/>
    <worldbody>

        <!-- 地面 -->
        <geom
            name="ground"
            type="plane"
            size="5 5 0.1"
            pos="0 0 0"
            rgba="0.7 0.7 0.7 1"
        />

        <!-- 桌子：抬高 + 靠近机器人 -->
        <!-- 桌面顶部从 0.60m 提到 0.70m -->
        <!-- 桌面前沿从 0.15m 移到 0.10m，更靠近机器人 -->
        <body name="table" pos="0.45 0 0.65">

            <geom
                name="table_top"
                type="box"
                size="0.35 0.35 0.05"
                pos="0 0 0"
                rgba="0.5 0.5 0.5 1"
            />

            <geom name="table_leg_1" type="box" size="0.03 0.03 0.33" pos=" 0.30  0.30 -0.38"/>
            <geom name="table_leg_2" type="box" size="0.03 0.03 0.33" pos=" 0.30 -0.30 -0.38"/>
            <geom name="table_leg_3" type="box" size="0.03 0.03 0.33" pos="-0.30  0.30 -0.38"/>
            <geom name="table_leg_4" type="box" size="0.03 0.03 0.33" pos="-0.30 -0.30 -0.38"/>

        </body>

        <!-- Cube：放在桌面前边缘，更靠近机器人 -->
        <body
            name="cube"
            pos="0.25 0.05 0.80"
        >

            <freejoint/>

            <geom
                name="cube_geom"
                type="box"
                size="0.03 0.03 0.03"
                mass="0.1"
                friction="1 0.5 0.5"
                rgba="0.8 0.2 0.2 1"
            />

        </body>

    </worldbody>

</mujoco>
