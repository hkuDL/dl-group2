<mujoco model="g1_29dof_tabletop">

  <!-- SONIC deployment 配套的 G1 29-DoF 模型。
       该 XML 已经包含 G1 和 floor。 -->
  <include file="../third_party/GR00T-WholeBodyControl/gear_sonic_deploy/g1/g1_29dof.xml"/>

  <statistic center="0.3 0 0.7" extent="2.0"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6"
               ambient="0.3 0.3 0.3"
               specular="0 0 0"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <material name="table_mat"
              rgba="0.55 0.35 0.20 1"/>

    <material name="cube_mat"
              rgba="0.85 0.15 0.10 1"/>
  </asset>

  <worldbody>

    <!-- 桌子 -->
    <body name="table" pos="0.65 0 0">

      <geom name="table_top"
            type="box"
            pos="0 0 0.72"
            size="0.35 0.50 0.04"
            material="table_mat"
            contype="1"
            conaffinity="1"/>

      <geom name="table_leg_1"
            type="box"
            pos="0.27 0.42 0.35"
            size="0.035 0.035 0.35"
            material="table_mat"/>

      <geom name="table_leg_2"
            type="box"
            pos="0.27 -0.42 0.35"
            size="0.035 0.035 0.35"
            material="table_mat"/>

      <geom name="table_leg_3"
            type="box"
            pos="-0.27 0.42 0.35"
            size="0.035 0.035 0.35"
            material="table_mat"/>

      <geom name="table_leg_4"
            type="box"
            pos="-0.27 -0.42 0.35"
            size="0.035 0.035 0.35"
            material="table_mat"/>

    </body>

    <!-- 待抓取 cube -->
    <body name="cube_body" pos="0.45 0 0.80">

      <freejoint name="cube_joint"/>

      <geom name="cube"
            type="box"
            size="0.035 0.035 0.035"
            mass="0.10"
            material="cube_mat"
            friction="0.9 0.01 0.001"
            contype="1"
            conaffinity="1"/>

    </body>

  </worldbody>

</mujoco>
