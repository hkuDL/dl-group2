+    void AlignContinuation(MotionSequence& next, const MotionSequence& held, int held_frame) {
+      // Make the first reference window exactly continuous with the held final
+      // frame.  The offset is smoothly removed while the new clip takes over.
+      const int blend_frames = std::min(20, next.timesteps);
+      if (blend_frames <= 0) return;
+
+      const int joint_count = std::min(next.GetNumJoints(), held.GetNumJoints());
+      const int body_count = std::min(next.GetNumBodies(), held.GetNumBodies());
+      const int quat_count = std::min(next.GetNumBodyQuaternions(), held.GetNumBodyQuaternions());
+
+      std::vector<double> joint_offset(joint_count, 0.0);
+      for (int joint = 0; joint < joint_count; ++joint) {
+        joint_offset[joint] = held.JointPositions(held_frame)[joint] - next.JointPositions(0)[joint];
+      }
+      std::vector<MotionSequence::Point> body_offset(body_count);
+      for (int body = 0; body < body_count; ++body) {
+        for (int axis = 0; axis < 3; ++axis) {
+          body_offset[body][axis] = held.BodyPositions(held_frame)[body][axis] - next.BodyPositions(0)[body][axis];
+        }
+      }
+
+      for (int frame = 0; frame < blend_frames; ++frame) {
+        const double u = blend_frames == 1 ? 1.0 : static_cast<double>(frame) / (blend_frames - 1);
+        const double alpha = u * u * (3.0 - 2.0 * u);  // smoothstep
+        const double held_weight = 1.0 - alpha;
+        for (int joint = 0; joint < joint_count; ++joint) {
+          next.JointPositions(frame)[joint] += held_weight * joint_offset[joint];
+          next.JointVelocities(frame)[joint] *= alpha;
+        }
+        for (int body = 0; body < body_count; ++body) {
+          for (int axis = 0; axis < 3; ++axis) {
+            next.BodyPositions(frame)[body][axis] += held_weight * body_offset[body][axis];
+            next.BodyLinVelocities(frame)[body][axis] *= alpha;
+            next.BodyAngVelocities(frame)[body][axis] *= alpha;
+          }
+        }
+        for (int body = 0; body < quat_count; ++body) {
+          const auto old_q = held.BodyQuaternions(held_frame)[body];
+          auto* new_q = &next.BodyQuaternions(frame)[body];
+          double sign = 1.0;
+          double dot = 0.0;
+          for (int axis = 0; axis < 4; ++axis) dot += old_q[axis] * (*new_q)[axis];
+          if (dot < 0.0) sign = -1.0;
+          double norm = 0.0;
+          for (int axis = 0; axis < 4; ++axis) {
+            (*new_q)[axis] = held_weight * old_q[axis] + alpha * sign * (*new_q)[axis];
+            norm += (*new_q)[axis] * (*new_q)[axis];
+          }
+          norm = std::sqrt(std::max(norm, 1e-12));
+          for (int axis = 0; axis < 4; ++axis) (*new_q)[axis] /= norm;
+        }
+      }
+    }
