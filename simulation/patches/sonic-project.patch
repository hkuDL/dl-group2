index 0000000000000000000000000000000000000000..75bce2cc2c970eac2ee0631e73bcba8ea74ed22a
--- /dev/null
+++ b/gear_sonic_deploy/scripts/musa_onnx.py
@@ -0,0 +1,117 @@
+"""Exact SONIC ONNX graph execution on Torch/MUSA; native controller owns I/O semantics."""
+import warnings
+from pathlib import Path
+import numpy as np
+import onnx
+from onnx import numpy_helper, helper
+import torch
+import torch_musa
+DTYPES={1:torch.float32,6:torch.int32,7:torch.int64,9:torch.bool,10:torch.float16,11:torch.float64}
+def values(x):return x.cpu().reshape(-1).tolist()
+def execute(model, initializers, tensor):
+ env=dict(initializers)
+ env[model.graph.input[0].name]=tensor
+ for node in model.graph.node:
+  a={x.name:helper.get_attribute_value(x) for x in node.attribute};x=[env[k] if k else None for k in node.input];op=node.op_type
+  try:
+   if op=='Constant':y=torch.from_numpy(numpy_helper.to_array(a['value']).copy()).to('musa')
+   elif op=='Add':y=x[0]+x[1]
+   elif op=='Sub':y=x[0]-x[1]
+   elif op=='Mul':y=x[0]*x[1]
+   elif op=='Div':y=x[0]/x[1]
+   elif op=='MatMul':y=x[0]@x[1]
+   elif op=='Gemm':
+    lhs=x[0].T if a.get('transA',0) else x[0];rhs=x[1].T if a.get('transB',0) else x[1]
+    y=a.get('alpha',1.)*(lhs@rhs)+(a.get('beta',1.)*x[2] if len(x)>2 else 0)
+   elif op=='Sigmoid':y=torch.sigmoid(x[0])
+   elif op=='Tanh':y=torch.tanh(x[0])
+   elif op=='Round':y=torch.round(x[0])
+   elif op=='Reshape':
+    shape=[int(v) for v in values(x[1])];shape=[x[0].shape[i] if v==0 and not a.get('allowzero',0) else v for i,v in enumerate(shape)];y=x[0].reshape(shape)
+   elif op=='Shape':y=torch.tensor(list(x[0].shape)[a.get('start',0):a.get('end',len(x[0].shape))],device='musa',dtype=torch.int64)
+   elif op=='Cast':y=x[0].to(DTYPES[a['to']])
+   elif op=='Concat':y=torch.cat(x,dim=a['axis'])
+   elif op=='Transpose':y=x[0].permute(a.get('perm',list(reversed(range(x[0].ndim)))))
+   elif op=='Unsqueeze':
+    y=x[0];axes=values(x[1]) if len(x)>1 else a['axes']
+    for axis in sorted(int(i)%(x[0].ndim+len(axes)) for i in axes):y=y.unsqueeze(axis)
+   elif op=='Squeeze':
+    y=x[0];axes=values(x[1]) if len(x)>1 else a.get('axes')
+    if axes is None:y=y.squeeze()
+    else:
+     for axis in sorted([int(i)%x[0].ndim for i in axes],reverse=True):
+      assert y.shape[axis]==1;y=y.squeeze(axis)
+   elif op=='Slice':
+    starts=values(x[1]);ends=values(x[2]);axes=values(x[3]) if len(x)>3 else range(len(starts));steps=values(x[4]) if len(x)>4 else [1]*len(starts);s=[slice(None)]*x[0].ndim
+    for st,en,ax,step in zip(starts,ends,axes,steps):s[int(ax)]=slice(int(st),int(en),int(step))
+    y=x[0][tuple(s)]
+   elif op=='Equal':y=x[0]==x[1]
+   elif op=='Where':y=torch.where(x[0],x[1],x[2])
+   elif op=='Expand':y=x[0].expand(torch.broadcast_shapes(x[0].shape,tuple(int(v) for v in values(x[1]))))
+   elif op=='ConstantOfShape':
+    val=numpy_helper.to_array(a['value']).copy() if 'value' in a else np.array([0],dtype=np.float32);y=torch.full(tuple(int(v) for v in values(x[0])),val.item(),device='musa',dtype=torch.from_numpy(val).dtype)
+   elif op=='Gather':
+    axis=a.get('axis',0)%x[0].ndim;idx=x[1].long();idx=torch.where(idx<0,idx+x[0].shape[axis],idx);y=torch.index_select(x[0],axis,idx.reshape(-1)).reshape((*x[0].shape[:axis],*idx.shape,*x[0].shape[axis+1:]))
+   elif op=='ScatterND':
+    assert a.get('reduction',b'none')==b'none';y=x[0].clone();indices=x[1].long();k=indices.shape[-1];flat=indices.reshape(-1,k);updates=x[2].reshape((-1,*x[0].shape[k:]));y[tuple(flat[:,i] for i in range(k))]=updates
+   elif op=='ReduceSum':y=x[0].sum(dim=tuple(int(v) for v in values(x[1])) if len(x)>1 else tuple(a.get('axes',range(x[0].ndim))),keepdim=bool(a.get('keepdims',1)))
+   else:raise NotImplementedError(op)
+   assert len(node.output)==1;env[node.output[0]]=y
+  except Exception as e:raise RuntimeError(f'{node.name} ({op}): {e}') from e
+ return env[model.graph.output[0].name]
+
+class Graph(torch.nn.Module):
+    def __init__(self, model):
+        super().__init__()
+        self.model=model
+        self.weights={a.name:torch.from_numpy(numpy_helper.to_array(a).copy()).to('musa') for a in model.graph.initializer}
+    def forward(self, tensor):
+        return execute(self.model, self.weights, tensor)
+
+class Session:
+    def __init__(self, path, output_name):
+        torch.set_num_threads(1)
+        if not torch.musa.is_available():
+            raise RuntimeError('MUSA is unavailable; CPU inference fallback is forbidden')
+        self.model=onnx.load(path)
+        onnx.checker.check_model(self.model)
+        if len(self.model.graph.input)!=1 or len(self.model.graph.output)!=1:
+            raise ValueError('Expected single ONNX input/output')
+        inp=self.model.graph.input[0];out=self.model.graph.output[0]
+        if inp.name!='obs_dict' or out.name!=output_name:
+            raise ValueError('ONNX I/O names differ from SONIC contract')
+        if inp.type.tensor_type.elem_type!=1 or out.type.tensor_type.elem_type!=1:
+            raise ValueError('SONIC requires FP32 model I/O')
+        shape=[d.dim_value for d in inp.type.tensor_type.shape.dim]
+        out_shape=[d.dim_value for d in out.type.tensor_type.shape.dim]
+        if len(shape)!=2 or shape[0]!=1 or any(d<=0 for d in shape+out_shape):
+            raise ValueError('Only fixed batch-one ONNX graphs are supported')
+        self.input_dimension=int(np.prod(shape));self.output_dimension=int(np.prod(out_shape))
+        self.input=torch.zeros(shape,device='musa',dtype=torch.float32)
+        graph=Graph(self.model).eval()
+        # Shapes/axes are fixed by the original ONNX. Tensor arithmetic and mode
+        # selection remain in the traced graph; no observations are precomputed.
+        with torch.no_grad(), warnings.catch_warnings():
+            warnings.simplefilter('ignore',torch.jit.TracerWarning)
+            self.graph=torch.jit.trace(graph,self.input,check_trace=False).eval()
+            # Validate tracing against the original operator interpreter for
+            # distinct inputs and every encoder mode, before control starts.
+            gen=np.random.default_rng(20261003)
+            for mode in ([0,1,2] if output_name=='encoded_tokens' else [0]):
+                x=torch.from_numpy((gen.standard_normal(shape)*.1).astype(np.float32)).to('musa')
+                if output_name=='encoded_tokens':x[0,:4]=torch.tensor([mode,0,0,0],device='musa')
+                exact=graph(x);compiled=self.graph(x)
+                torch.testing.assert_close(compiled.cpu(),exact.cpu(),atol=1e-6,rtol=1e-6)
+            for _ in range(3):self.output=self.graph(self.input)
+        torch.musa.synchronize()
+        print(f'SONIC MUSA {output_name}: {path}, {shape} -> {out_shape}, FP32',flush=True)
+
+    def run(self, buffer):
+        x=np.frombuffer(buffer,dtype=np.float32)
+        if x.size!=self.input_dimension:raise ValueError('Observation length mismatch')
+        with torch.no_grad():
+            self.input.copy_(torch.from_numpy(x.copy()).reshape(self.input.shape))
+            self.output=self.graph(self.input)
+            result=self.output.cpu().numpy()
+        if not np.isfinite(result).all():raise RuntimeError('Nonfinite MUSA output')
+        return result.tobytes()
